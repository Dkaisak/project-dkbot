  "_doc": {
    "offsets.player_base": "Punto de entrada al struct del jugador. mode=static usa 'address' (direccion absoluta donde vive el puntero); mode=signature escanea 'signature' en 'module'. 'rip_relative' usa operand_offset como rel32. 'chain' es una lista de offsets puntero-a-puntero; 'deref' son desreferencias extra al final.",
    "offsets.player.fields": "Offsets de cada campo respecto al struct del jugador. type: i32/u32/u16/u8/f32/f64/bool/str/str_utf16.",
    "offsets.battle_list": "Array de criaturas. 'deref' indica si el offset apunta a un puntero al array. 'pointer_array' indica array de punteros. 'count' lee el numero de entradas; si no, usa 'count_fixed'.",
    "offsets.party": "Array del equipo Pokemon.",
    "offsets.inventory": "Array de inventario/mochila.",
    "offsets.map": "Celdas del mapa alrededor del jugador (radio * 2 + 1 entradas).",
    "route.waypoints": "Lista de [x, y, z] por los que patrullar.",
    "route.static_map": "Mapa de walkability opcional: lista de strings, '#'/'X' = bloqueado."
  },
